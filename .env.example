# --- Database (Postgres). If you don't have one, create a free Neon/Vercel Postgres
# database from your Vercel project's Storage tab and paste the connection string here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Vercel Blob (for receipt uploads) ---
# Create from your Vercel project's Storage tab -> Blob -> Create Store.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- Outgoing mail (Nodemailer / SMTP) ---
# The staff member in charge of email supplies these. For Gmail, use an
# "App Password" (not the regular password) - myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-school-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_FROM_NAME="Campus Companion"

# --- First admin account bootstrap ---
# On first run, visit /api/auth/register with role ADMIN blocked by default;
# instead set this and use the /admin/bootstrap flow described in README.
ADMIN_BOOTSTRAP_KEY="choose-a-long-random-string"

# Public URL of the deployed app, used inside emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"
